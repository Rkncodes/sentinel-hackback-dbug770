# Sentinel configuration. Placeholder values only; never commit real keys.
#
# Sentinel and the demo portal read these from the process environment.
# Neither loads a .env file by itself: export the variables in your shell,
# or use a tool that loads this file before starting the process.

# --- Sentinel service (python -m sentinel) ---

# Required. Held by the portal; accepted by POST /v1/login-attempts and GET /v1/check.
SENTINEL_PORTAL_KEY=replace-with-a-long-random-portal-key

# Required. Held by administrators; accepted by GET /v1/bans and DELETE /v1/bans/{id}.
# Must be different from the portal key.
SENTINEL_ADMIN_KEY=replace-with-a-different-long-random-admin-key

# Optional. Failed logins in the window that trigger a ban. Positive integer.
SENTINEL_THRESHOLD=10

# Optional. Length of the sliding window, in seconds. Positive integer.
SENTINEL_WINDOW_SECONDS=60

# Optional. How long a ban lasts, in seconds. Positive integer. Default is 15 minutes.
# For a live demo, a short value such as 30 lets expiry be watched.
SENTINEL_BAN_DURATION_SECONDS=900

# Optional. SQLite file that holds the bans.
SENTINEL_DB_PATH=./sentinel.db

# Optional. Address and port the service listens on.
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8080

# --- Demo portal only (python demo/portal.py) ---
# The demo also needs SENTINEL_PORTAL_KEY and SENTINEL_ADMIN_KEY, with the same values as above.

# Optional. Where the demo portal reaches Sentinel.
SENTINEL_URL=http://127.0.0.1:8080

# Optional. Port the demo portal listens on (always on 127.0.0.1).
DEMO_PORT=8081
